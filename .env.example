# Docker Compose reads the root .env; do not commit .env.
# Required. Set once before creating the PostgreSQL volume (for example with openssl rand -hex 32).
DECOCTION_POSTGRES_PASSWORD=

# Optional public Python package index for image builds. Defaults to PyPI.
DECOCTION_PIP_INDEX_URL=

# Use 0.0.0.0 for direct access from other computers, or keep loopback behind a proxy.
DECOCTION_BIND_IP=127.0.0.1
DECOCTION_HTTP_PORT=8080

# Exact browser origins, including scheme and port; also checked for WebSocket.
# For a server, replace these with http://SERVER_IP:8080 or https://YOUR_DOMAIN.
DECOCTION_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional shared demo key. It is bundled into browser JavaScript during build.
# This is NOT a private server secret or user authentication. Rebuild after changes.
# Use a VPN or authenticated HTTPS gateway to restrict access to this application.
DECOCTION_API_KEY=
