# Set environment variables explicitly; the application does not auto-load this file.
DECOCTION_DATABASE_URL=postgresql://decoction:CHANGE_ME@127.0.0.1:5432/decoction
DECOCTION_API_KEY=
DECOCTION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Normal operation is real time, fixed 1x. Enable only for an isolated test database.
DECOCTION_ALLOW_DEBUG_STEP=0
